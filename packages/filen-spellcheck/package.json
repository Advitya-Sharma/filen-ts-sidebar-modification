{
	"name": "@filen/spellcheck",
	"version": "0.0.1",
	"description": "On-device spellchecking for the Filen apps: spellbook (Rust) as wasm, Hunspell dictionaries, workers",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/FilenCloudDienste/filen-ts/packages/filen-spellcheck"
	},
	"author": "Filen Cloud Dienste UG",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./engine": "./src/engine.ts",
		"./worker": "./src/worker.ts",
		"./host": "./src/host.ts",
		"./build-wasm": "./scripts/build-wasm.mjs",
		"./dictionaries/*": "./dictionaries/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build:wasm": "node scripts/build-wasm.mjs",
		"build:dictionaries": "node scripts/build-dictionaries.ts",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:rust": "cargo test --manifest-path crate/Cargo.toml",
		"test:miri": "cargo +nightly-2026-02-20 miri test --manifest-path crate/Cargo.toml --ignore-rust-version boundary::",
		"lint": "eslint src/ scripts/ && prettier --check \"{src,scripts}/**/*.{ts,mjs}\"",
		"lint:rust": "cargo fmt --manifest-path crate/Cargo.toml --check && cargo clippy --manifest-path crate/Cargo.toml --all-targets -- -D warnings && cargo clippy --manifest-path crate/Cargo.toml --release --target wasm32-unknown-unknown -- -D warnings"
	},
	"engines": {
		"node": ">=24"
	},
	"license": "AGPLv3",
	"devDependencies": {
		"@eslint/js": "^9.39.3",
		"@types/node": "^24.0.0",
		"eslint": "^9.39.3",
		"prettier": "^3.9.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.1.11"
	}
}
