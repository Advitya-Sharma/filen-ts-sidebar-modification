{
	"name": "@filen/office",
	"version": "0.0.1",
	"description": "Document engines and editors shared by the Filen apps",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/FilenCloudDienste/filen-ts/packages/filen-office"
	},
	"author": "Filen Cloud Dienste UG",
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./core/opc": "./src/core/opc/index.ts",
		"./core/cfb": "./src/core/cfb/index.ts",
		"./core/encryption": "./src/core/encryption/index.ts",
		"./core/xml": "./src/core/xml/index.ts",
		"./core/fonts": "./src/core/fonts/index.ts",
		"./core/docx": "./src/core/docx/index.ts",
		"./core/drawingml": "./src/core/drawingml/index.ts",
		"./core/vml": "./src/core/vml/index.ts",
		"./core/math": "./src/core/math/index.ts",
		"./core/text": "./src/core/text/index.ts",
		"./core/sheet": "./src/core/sheet/index.ts",
		"./core/xlsx": "./src/core/xlsx/index.ts",
		"./dom": "./src/dom/index.ts",
		"./dom/encryption": "./src/dom/encryption/index.ts",
		"./dom/encryption/seal": "./src/dom/encryption/seal.ts",
		"./testing/encryption": "./src/tests/encryption/testing.ts",
		"./assets/fonts/*": "./assets/fonts/*",
		"./dom/docx": "./src/dom/docx/index.ts",
		"./react/docx": "./src/react/docx/index.ts",
		"./css/docx.css": "./src/css/docx.css",
		"./css/docx-review.css": "./src/css/docx-review.css",
		"./css/docx-objects.css": "./src/css/docx-objects.css",
		"./css/docx-reflow.css": "./src/css/docx-reflow.css",
		"./core/docx/edit": "./src/core/docx/edit/index.ts",
		"./core/docx/write": "./src/core/docx/write/index.ts",
		"./core/docx/paged": "./src/core/docx/paged/index.ts",
		"./core/docx/spelling": "./src/core/docx/spelling/index.ts",
		"./dom/docx/editing": "./src/dom/docx/editing.ts",
		"./dom/docx/save": "./src/dom/docx/save.ts",
		"./react/docx/editor": "./src/react/docx/editor.ts",
		"./core/markdown": "./src/core/markdown/index.ts",
		"./react/markdown": "./src/react/markdown/index.ts"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.react.json && tsc -p tsconfig.test.json && tsc -p tsconfig.dom-test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench": "node --expose-gc --import tsx src/bench/bench.ts",
		"bench:text": "node --expose-gc --import tsx src/bench/textBench.ts",
		"generate:fonts": "tsx src/scripts/fontTables.ts",
		"generate:unicode": "tsx src/scripts/unicodeTables.ts",
		"generate:geometry": "tsx src/scripts/presetGeometry.ts",
		"generate:symbols": "tsx src/scripts/symbolTables.ts",
		"generate:wml-order": "tsx src/scripts/wmlOrder.ts",
		"generate:sml-order": "tsx src/scripts/smlOrder.ts",
		"oracles:sheet-suites": "tsx src/tests/oracles/sheet/functionSuites.ts --fetch",
		"corpus:manifest": "tsx src/scripts/corpusManifest.ts",
		"corpus:fetch": "tsx src/scripts/fetchCorpus.ts",
		"lint": "eslint src/ && prettier --check \"src/**/*.{ts,tsx,css}\""
	},
	"engines": {
		"node": ">=24"
	},
	"license": "AGPLv3",
	"devDependencies": {
		"@codemirror/state": "6.7.4",
		"@eslint/js": "^9.39.3",
		"@types/node": "^24.0.0",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.3",
		"eslint": "^9.39.3",
		"happy-dom": "^20.14.0",
		"hyperformula": "3.4.0",
		"prettier": "^3.9.6",
		"prosemirror-history": "1.5.1",
		"prosemirror-model": "1.25.12",
		"prosemirror-state": "1.4.4",
		"prosemirror-transform": "1.12.2",
		"prosemirror-view": "1.42.6",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"tsx": "4.23.13",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@filen/shared": "workspace:*",
		"fflate": "0.8.3"
	},
	"peerDependencies": {
		"@codemirror/state": "^6.7.4",
		"prosemirror-history": "^1.5.1",
		"prosemirror-model": "^1.25.12",
		"prosemirror-state": "^1.4.4",
		"prosemirror-transform": "^1.12.2",
		"prosemirror-view": "^1.42.6",
		"react": ">=19.2.3",
		"react-dom": ">=19.2.3",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1"
	},
	"peerDependenciesMeta": {
		"@codemirror/state": {
			"optional": true
		},
		"prosemirror-history": {
			"optional": true
		},
		"prosemirror-model": {
			"optional": true
		},
		"prosemirror-state": {
			"optional": true
		},
		"prosemirror-transform": {
			"optional": true
		},
		"prosemirror-view": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"react-markdown": {
			"optional": true
		},
		"remark-gfm": {
			"optional": true
		}
	}
}
