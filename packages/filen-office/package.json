{
	"name": "@filen/office",
	"version": "0.0.1",
	"description": "Document engines and editors shared by the Filen apps",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/FilenCloudDienste/filen-ts/packages/filen-office"
	},
	"author": "Filen Cloud Dienste UG",
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./core/opc": "./src/core/opc/index.ts",
		"./core/xml": "./src/core/xml/index.ts",
		"./core/fonts": "./src/core/fonts/index.ts",
		"./core/docx": "./src/core/docx/index.ts",
		"./core/drawingml": "./src/core/drawingml/index.ts",
		"./core/vml": "./src/core/vml/index.ts",
		"./core/math": "./src/core/math/index.ts",
		"./core/text": "./src/core/text/index.ts",
		"./dom": "./src/dom/index.ts",
		"./assets/fonts/*": "./assets/fonts/*"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"bench": "node --expose-gc --import tsx src/bench/bench.ts",
		"bench:text": "node --expose-gc --import tsx src/bench/textBench.ts",
		"generate:fonts": "tsx src/scripts/fontTables.ts",
		"generate:unicode": "tsx src/scripts/unicodeTables.ts",
		"generate:geometry": "tsx src/scripts/presetGeometry.ts",
		"corpus:manifest": "tsx src/scripts/corpusManifest.ts",
		"corpus:fetch": "tsx src/scripts/fetchCorpus.ts",
		"lint": "eslint src/ && prettier --check \"src/**/*.ts\""
	},
	"engines": {
		"node": ">=24"
	},
	"license": "AGPLv3",
	"devDependencies": {
		"@eslint/js": "^9.39.3",
		"@types/node": "^24.0.0",
		"eslint": "^9.39.3",
		"prettier": "^3.9.6",
		"tsx": "4.23.13",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"fflate": "0.8.3"
	}
}
