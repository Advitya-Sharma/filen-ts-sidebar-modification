diff --git a/cpp/wllama-fs.h b/cpp/wllama-fs.h
index 5832b20..40d516f 100644
--- a/cpp/wllama-fs.h
+++ b/cpp/wllama-fs.h
@@ -17,6 +17,9 @@ namespace wllama_fs
   bool use_async = false;
 
   static const size_t CACHE_SIZE = 1024 * 1024; // 1 MB read-ahead
+  // Larger reads are requested in pieces: each request comes back as one JavaScript buffer of its size,
+  // which stays in memory until the next garbage collection.
+  static const size_t READ_PIECE = 16 * 1024 * 1024;
 
   std::vector<uint8_t> cache_data;
   size_t cache_start = 0;
@@ -109,13 +112,20 @@ extern "C"
     // Large reads (>= 1 MB): write directly into ptr, skip cache entirely.
     if (req_bytes >= wllama_fs::CACHE_SIZE)
     {
-      size_t actual = (size_t)js_file_read(
-          nit->second.c_str(), fpos, req_bytes, ptr);
-      if (actual == 0)
+      size_t done = 0;
+      while (done < req_bytes)
+      {
+        size_t piece = std::min(req_bytes - done, wllama_fs::READ_PIECE);
+        size_t actual = (size_t)js_file_read(
+            nit->second.c_str(), fpos + done, piece, (char *)ptr + done);
+        done += std::min(piece, actual);
+        if (actual < piece)
+          break;
+      }
+      if (done == 0)
         return 0;
-      size_t copy_bytes = std::min(req_bytes, actual);
-      __real_fseek(f, fpos + copy_bytes, SEEK_SET);
-      return copy_bytes / size;
+      __real_fseek(f, fpos + done, SEEK_SET);
+      return done / size;
     }
 
     // Small reads: try cache first.
