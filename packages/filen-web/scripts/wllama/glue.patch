+                        file->read_raw(read_buf.data(), len);
+                        ggml_backend_tensor_set(cur, read_buf.data(), done, len);
+                    }
                     if (check_tensors && !ggml_validate_row_data(cur->type, read_buf.data(), n_size)) {
