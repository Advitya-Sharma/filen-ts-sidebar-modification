+  /**
+   * Patched (filen): refreshes the notification of an already-running foreground service in place.
+   *
+   * <p>Returns false unless this notification is the one the live, promoted service is serving
+   * with no START/STOP in flight and an unchanged foreground-service type; every other case needs a
+   * real {@code startForeground()} and goes through {@link #start}.
+   *
+   * <p>Exists so that repeated {@code displayNotification()} calls for a live foreground service
+   * (progress updates) stop issuing redundant {@code startForegroundService()} intents.
+   */
+  @SuppressLint("MissingPermission")
+  static boolean updateIfActive(NotificationModel model, int hashCode, Notification notification) {
+    Context context = ContextHolder.getApplicationContext();
+    if (context == null) {
+      return false;
+    }
+
+    // Resolve the type before taking the locks: it may perform PackageManager IPC.
+    int resolvedType = ServiceInfo.FOREGROUND_SERVICE_TYPE_NONE;
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+      resolvedType = model.getAndroid().getForegroundServiceType();
+      if (resolvedType == ServiceInfo.FOREGROUND_SERVICE_TYPE_MANIFEST) {
+        resolvedType = resolveManifestServiceType();
+      }
+    }
+
+    try {
+      synchronized (sLifecycleLock) {
+        synchronized (sLock) {
+          ForegroundService owner = sInstance;
+          if (owner == null
+              || !owner.mForegroundActive
+              || sStateOwner != owner
+              || (owner.mForegroundEpoch != null && owner.mForegroundEpoch.retiring)
+              || sStopRequest != null
+              || !sPendingStarts.isEmpty()
+              || mCurrentNotificationId == null
+              || !mCurrentNotificationId.equals(model.getId())) {
+            return false;
+          }
+          if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q
+              && resolvedType != mCurrentForegroundServiceType) {
+            return false;
+          }
+          mCurrentNotification = notification;
+          mCurrentNotificationBundle = model.toBundle();
+          mCurrentHashCode = hashCode;
+          NotificationManagerCompat.from(context).notify(hashCode, notification);
+          return true;
+        }
+      }
+    } finally {
+      publishTimeoutEventsIfUnlocked();
+    }
+  }
