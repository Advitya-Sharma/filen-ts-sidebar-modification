diff --git a/ios/RNSScreenStack.mm b/ios/RNSScreenStack.mm
--- a/ios/RNSScreenStack.mm
+++ b/ios/RNSScreenStack.mm
@@ -407,9 +407,12 @@
         [self addSubview:controller.view];
 #if !TARGET_OS_TV
         _controller.interactivePopGestureRecognizer.delegate = self;
+        // Patched (filen): see setupGestureHandlers.
+        _controller.interactivePopGestureRecognizer.delaysTouchesBegan = NO;
 #if RNS_IPHONE_OS_VERSION_AVAILABLE(26_0)
         if (@available(iOS 26, *)) {
           _controller.interactiveContentPopGestureRecognizer.delegate = self;
+          _controller.interactiveContentPopGestureRecognizer.delaysTouchesBegan = NO;
         }
 #endif // Check for iOS >= 26.0
 #endif
@@ -947,17 +950,25 @@
 #if !TARGET_OS_TV && !TARGET_OS_VISION
 - (void)setupGestureHandlers
 {
+  // Patched (filen): UIKit creates edge-pan recognizers, and the navigation controller's back-swipe
+  // recognizers, with delaysTouchesBegan = YES, and on iOS 26 they stay Possible while a finger rests
+  // anywhere on a pushed screen. Touches to UIControl-based views (react-native-gesture-handler
+  // buttons) were then withheld until release: no press feedback, no long press, a long press became
+  // a tap. RN's touch handler is a recognizer and never saw the delay. A recognized swipe still
+  // cancels the touch (cancelsTouchesInView), so the back gestures are unaffected. Upstreamable.
   // gesture recognizers for custom stack animations
   RNSScreenEdgeGestureRecognizer *leftEdgeSwipeGestureRecognizer =
       [[RNSScreenEdgeGestureRecognizer alloc] initWithTarget:self action:@selector(handleSwipe:)];
   leftEdgeSwipeGestureRecognizer.edges = UIRectEdgeLeft;
   leftEdgeSwipeGestureRecognizer.delegate = self;
+  leftEdgeSwipeGestureRecognizer.delaysTouchesBegan = NO;
   [self addGestureRecognizer:leftEdgeSwipeGestureRecognizer];
 
   RNSScreenEdgeGestureRecognizer *rightEdgeSwipeGestureRecognizer =
       [[RNSScreenEdgeGestureRecognizer alloc] initWithTarget:self action:@selector(handleSwipe:)];
   rightEdgeSwipeGestureRecognizer.edges = UIRectEdgeRight;
   rightEdgeSwipeGestureRecognizer.delegate = self;
+  rightEdgeSwipeGestureRecognizer.delaysTouchesBegan = NO;
   [self addGestureRecognizer:rightEdgeSwipeGestureRecognizer];
 
   // Starting from iOS 26, RNSPanGestureRecognizer has been mostly replaced by native
